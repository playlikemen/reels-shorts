         {"label": "UNDER 100K", "value": 0.1, "text": "$0.10", "color": "black", "at": "Above"},
         {"label": "OVER 100K", "value": 0.5, "text": "$0.50", "color": "white", "at": "thousand tokens"},
         {"label": "HAIKU 4.5", "value": 1.0, "text": "$1.00", "ghost": true, "at": "only"}]},
       {"type": "stamp", "text": "HALF OFF", "color": "white", "size": 70, "at": "half off", "mt": 10}
     ]},
    {"chapter": "01 PRICE", "bg": "paper",
     "say": "And Anthropic's own estimate is about seventy-five percent cheaper on average.",
     "els": [
       {"type": "label", "text": "ANTHROPIC'S ESTIMATE", "variant": "dark", "at": "estimate"},
       {"type": "stat", "text": "~75%", "size": 230, "count": {"from": 0, "to": 75, "prefix": "~", "suffix": "%"}, "at": "seventy-five"},
       {"type": "tag", "text": "CHEAPER ON AVERAGE", "color": "mint", "size": 66, "at": "on average"},
       {"type": "row", "gap": 18, "mt": 40, "at": "cheaper", "children": [
         {"type": "icon", "name": "trend", "size": 120, "bg": "paper", "color": "purple"},
