       {"type": "row", "gap": 14, "align": "center", "at": "Anthropic", "children": [
         {"type": "kicker", "text": "ANTHROPIC"},
         {"type": "tag", "text": "NEW", "color": "pink", "size": 30, "rot": -5, "anim": "stamp"}]},
       {"type": "headline", "text": "HAIKU [[5.5]]", "size": 150, "at": "Haiku"},
       {"type": "serif", "text": "Claude Haiku 5.5", "at": "calling", "ml": 20},
       {"type": "collage", "w": 250, "h": 230, "abs": [400, 455], "at": "calling", "tiles": [
