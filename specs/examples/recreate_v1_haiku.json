       {"type": "label", "text": "FOR MOST REQUESTS", "variant": "dark", "at": "most requests"},
       {"type": "row", "gap": 34, "mt": 30, "at": "ten times", "children": [
         {"type": "bars", "h": 420, "bw": 120, "max": 1.0, "items": [
           {"label": "HAIKU 4.5", "value": 1.0, "text": "$1.00", "color": "black", "at": "most requests"},
           {"label": "HAIKU 5.5", "value": 0.1, "text": "$0.10", "color": "purple", "at": "cheaper"}]},
         {"type": "col", "gap": 6, "children": [
           {"type": "stat", "text": "10×", "size": 170, "at": "ten times"},
           {"type": "tag", "text": "CHEAPER", "color": "pink", "at": "cheaper"}]}]}
     ]},
    {"chapter": "01 PRICE", "bg": "black",
     "say": "Input now costs ten cents per million tokens, which is the same price as OpenAI's GPT-6 Luna.",
     "els": [
       {"type": "bigmono", "text": "$0.10", "from": "$1.00", "at": "ten cents", "mt": 10},
       {"type": "note", "text": "PER 1M INPUT TOKENS", "at": "per million"},
       {"type": "tag", "text": "SAME PRICE", "color": "pink", "size": 92, "at": "same price", "mt": 20},
       {"type": "vs", "mt": 40, "at": "OpenAI's", "left": {"small": "HAIKU 5.5", "value": "$0.10", "shadow": "mint"},
        "right": {"small": "GPT-6 LUNA", "value": "$0.10", "shadow": "pink", "at": "Luna"}, "sym": "="}
     ]},
    {"chapter": "01 PRICE", "bg": "pink",
     "say": "Above one hundred thousand tokens, you only get half off.",
     "els": [
       {"type": "kicker", "text": "INPUT PRICE vs PROMPT LENGTH", "at": "Above"},
       {"type": "headline", "text": "100K+", "size": 120, "at": "hundred thousand"},
