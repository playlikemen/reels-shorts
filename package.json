{
  "name": "reels-shorts",
  "version": "1.0.0",
  "private": true,
  "description": "Programmatic video production engine for high-retention Instagram Reels and YouTube Shorts",
  "type": "module",
  "scripts": {
    "render": "node shared/scripts/render.mjs",
    "sheet:sync": "python3.11 shared/scripts/sync_sheet.py",
    "sheet:beautify": "python3.11 shared/scripts/sync_sheet.py --beautify",
    "drive:sync": "python3.11 shared/scripts/sync_drive.py",
    "publish:instagram": "python3.11 shared/scripts/publish_instagram.py",
    "publish:youtube": "python3.11 shared/scripts/publish_youtube.py",
    "series:plan": "python3.11 pipeline/build_linux_curriculum.py",
    "series:produce": "python3.11 pipeline/batch_linux_engine.py",
    "schedule:dry-run": "python3.11 pipeline/daily_scheduler.py --dry-run",
    "schedule:publish": "python3.11 pipeline/daily_scheduler.py --publish"
  },
  "dependencies": {
    "playwright-core": "^1.50.0",
    "three": "0.170.0"
  },
  "license": "MIT"
}
